# ---------------------------------------------------------------------------
# Build artifacts — regenerated by `make` + opensdk_packager in the container
# ---------------------------------------------------------------------------
bin/
trash/
src/*.o
*.cap

# ---------------------------------------------------------------------------
# Python bytecode (rpi/ scripts are copied to the Pi and run there)
# ---------------------------------------------------------------------------
__pycache__/
*.pyc
rpi/

# ---------------------------------------------------------------------------
# Local tool settings — machine-specific, and records internal IPs / accounts
# ---------------------------------------------------------------------------
.claude/settings.local.json
AGENTS.md
CLAUDE.md

# Local Git metadata backups
.git-backup*/
.git_backup*/

# ---------------------------------------------------------------------------
# Runtime capture data — regenerated by the app/Pi, not source
# (gitignore does not support end-of-line comments — keep patterns on their
# own lines)
# ---------------------------------------------------------------------------
# Calibration capture images (timestamped) — recreated on every run
imgs/
data/
# HG_SNAPSHOT runtime output (written by the Pi)
homography_reference.jpg
# Marker recorder (hg_experiment) output — new timestamped files per run
homography_12pt_*.json
homography_12pt_*.csv

# ---------------------------------------------------------------------------
# Generated images — source and document images stay tracked; only runtime
# output is excluded
# ---------------------------------------------------------------------------
# Experiment inputs, analyses and images are all covered by the data/ rule.

# Personal notes and scratch documents
*.local.md
notes/
scratch/
docs/archive/

# Tool / agent configuration directories
.claude/
.agents/
.codex/
.obsidian/

# ---------------------------------------------------------------------------
# Local deployment and network settings (real IPs, ports, accounts) — only the
# .example templates are committed
# ---------------------------------------------------------------------------
# Real IPs and ports for the C++ build (included by app_config.h)
inc/app_config_local.h
# Real host, account and ports for scp/ssh deployment
config.sh

# Generic secret files — only templates are tracked
.env
.env.*
!.env.example
.envrc
.netrc
.git-credentials
.npmrc
.pypirc
secrets/
credentials/
.secret
.secret.*
*.secret
*.secrets
*.credentials
password*.txt
passwd*
auth.local.*
*.key
*.pem
*.p12
*.pfx
*.kdbx
*.jks
id_rsa*
id_ed25519*
credentials*.json
token*.json

# Per-deployment central server certificate — a public key, but its SAN
# records internal IPs / DNS names
res/central_server.crt
res/images/central_server.crt


# ---------------------------------------------------------------------------
# App signing bundle (private key + public cert). The .key is an RSA PRIVATE
# KEY and must never be committed; the whole v5Test folder is excluded so the
# cert goes with it. Keep the folder in your working copy so opensdk_packager
# can sign. If the team versions the test bundle with the SDK, delete this rule
# deliberately rather than by accident.
# ---------------------------------------------------------------------------
v5Test (3Q_2026)/

# Hanwha OpenSDK app manifest — SDK-provided packaging metadata
IPCameraManifest.xml
