# 파이(RPi 비전 서버) 접속 정보.
#
#   cp pi.env.example pi.env
#   vi pi.env          # 실제 비밀번호를 넣는다
#
# pi.env 는 .gitignore 에 있다. 이 example 파일만 커밋된다.
# 비밀번호를 이 파일(.example)에 적지 말 것 — 이건 커밋된다.
#
# 주의: PI_HOST 는 Wi-Fi DHCP 라 재부팅 시 바뀔 수 있다(DHCP 예약 미설정).
# 붙지 않으면 IP 부터 확인할 것.

PI_HOST=192.168.0.8
PI_USER=team4
PI_PASS=
