# 4채널 중계용 카메라 접속 정보 템플릿.
#   cp cameras.env.example cameras.env    # cameras.env 는 gitignore 됨
#
# ⚠️ 아래 경로(/profile.../media.smp 부분)를 짐작해서 채우지 말 것.
#    틀린 경로로 반복 접속하면 Hanwha 카메라가 계정을 잠근다
#    (RTSP/1.0 490 Account Blocked). 반드시 probe_onvif.py 로 카메라가
#    직접 알려주는 URL 을 받아서 그대로 붙여넣는다:
#
#        python3 probe_onvif.py --host 192.168.0.X --user admin --password '...'
#
#    출력된 채널별 URL 을 MTX_PATHS_CH*_SOURCE 에 그대로 넣으면 된다.

# 카메라 계정 — probe_onvif.py 에도 같은 값을 쓴다.
CAM_USER=admin
CAM_PASS=changeme
CAM_HOST=192.168.0.12

# ---------------------------------------------------------------------------
# 채널별 원본 RTSP 주소 (probe_onvif.py 결과를 붙여넣는다)
#
# ⚠️ 비밀번호에 @ : / ? # 가 들어 있으면 URL 인코딩해야 한다
#    (@ 는 %40, : 는 %3A). 안 그러면 호스트 파싱이 깨진다.
# ---------------------------------------------------------------------------
MTX_PATHS_CH1_SOURCE=rtsp://admin:changeme@192.168.0.12:554/PUT_CH1_PATH_HERE
MTX_PATHS_CH2_SOURCE=rtsp://admin:changeme@192.168.0.12:554/PUT_CH2_PATH_HERE
MTX_PATHS_CH3_SOURCE=rtsp://admin:changeme@192.168.0.12:554/PUT_CH3_PATH_HERE
MTX_PATHS_CH4_SOURCE=rtsp://admin:changeme@192.168.0.12:554/PUT_CH4_PATH_HERE

# 중계가 클라이언트에게 열어주는 포트. 바꾸면 Qt 쪽 주소도 같이 바꿔야 한다.
MTX_RTSPADDRESS=:8554
