# --- 자격증명 ---------------------------------------------------------------
# build_install.sh 가 여기서 카메라 비밀번호를 읽는다. camera.env.example 만 커밋.
camera.env
# 파이(RPi 비전 서버) 접속 정보. pi.env.example 만 커밋.
pi.env
# sky(오디오 재생 파이) 접속 정보. sky.sh 가 여기서 읽는다.
sky.env
.env
.env.local

# 도구가 만드는 로컬 설정. 여기 permissions 문자열에 실행했던 curl 명령이 그대로
# 들어가고, 그 안에 비밀번호가 섞인다.
.claude/settings.local.json

# 배포별 중앙 서버 인증서 — 공개키지만 SAN에 내부 IP/DNS 이름이 들어 있다.
# cctv_app/.gitignore 의 동일 항목과 같은 이유. app_config.h의
# CENTRAL_TLS_CA_FILE 이 가리키는 파일이며, 없어도 빌드는 되고 링크만
# "offline"으로 남는다(fail-closed) — 카메라에 배포할 때 별도로 올릴 것.
app/res/cert/central_server.crt

# --- 문서 -------------------------------------------------------------------
# 작업 계획·핸드오프 문서. 저장소에 넣지 않는다.
docs/
rpi/
# --- 빌드 산출물 -------------------------------------------------------------
app/build/
app/build_stale/
app/bin/ArucoPosePNM
app/libs/sample_component/*.so
*.cap

# opensdk_install: SDK 이미지에서 꺼내오는 바이너리(133 KB). 없으면 스크립트가
# 알아서 다시 꺼낸다.
opensdk_install

# --- 캘리브레이션 백업 -------------------------------------------------------
# tools/calib_backup.sh 의 산출물. 특정 카메라 한 대의 실측값이라 저장소가 아니라
# 그 카메라를 운용하는 사람 손에 있어야 하는 것이고, 커밋하면 오래된 사본이
# 최신인 척하게 된다. 자격증명은 들어 있지 않다(복구 스크립트는 camera.env 를
# 읽는다).
backups/

# --- 측정 작업 폴더 ----------------------------------------------------------
# bench/ 는 특정 카메라·파이 한 쌍의 실측 기록과 그 장비에서만 의미가 있는
# 스크립트다. backups/ 와 같은 이유로 커밋하지 않는다.
bench/

# --- 잡동사니 ---------------------------------------------------------------
*.o
*.swp
*~
.DS_Store

# 빌드 보관 사본 (build_install.sh). .cap 은 8MB 씩이고 재생성 가능하다.
# INDEX.md 는 어느 사본이 무엇인지 적은 목록이라 같이 두되 추적하지 않는다.
builds/

# 붙여넣은 스크린샷 모음. 8MB 넘는 PNG 가 UUID 이름으로 쌓여 있고 문서에서
# 참조하지 않는다. 한 번 커밋하면 이후 clone 마다 따라다니므로 추적하지 않는다.
# 문서에 넣을 그림이 생기면 docs/ 아래에 이름을 붙여 두는 편이 낫다.
imgs/
